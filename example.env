# ==============================================================================
# ShininChrist Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Settings (Safe for browser / Set as "Config" in Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# ------------------------------------------------------------------------------
# 2. Database Connection Strings (SECRET: Server-only / Set as "Secret" in Vercel)
# Obtain from Supabase Dashboard > Project Settings > Database
# ------------------------------------------------------------------------------
# Transaction pooler (port 6543) for runtime queries:
DATABASE_URL="postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session pooler (port 5432) for Prisma CLI migrations:
DIRECT_URL="postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. Supabase Secret Key (SECRET: Server-only / Set as "Secret" in Vercel)
# Obtain from Supabase Dashboard > Project Settings > API Keys > Secret / service_role
# ------------------------------------------------------------------------------
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ------------------------------------------------------------------------------
# 4. Paystack Payment Gateway
# Obtain from Paystack Dashboard > Settings > API Keys & Webhooks
# ------------------------------------------------------------------------------
# Public key for client payments (Set as "Config" in Vercel):
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Secret key for server-side verification and webhooks (SECRET: Set as "Secret" in Vercel):
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Webhook destination address (Paste this same URL into your Paystack Dashboard):
NEXT_PUBLIC_PAYSTACK_WEBHOOK_URL=https://your-site.vercel.app/api/webhooks/paystack


# ------------------------------------------------------------------------------
# 5. Public address of this site (used for Google sign-in return address)
# Local development: leave EMPTY or unset (the browser address is used: localhost:3000, 3001, ...).
# Vercel Production: set to https://your-site.vercel.app (e.g. https://shininchrist.vercel.app), then redeploy.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# ------------------------------------------------------------------------------
# 6. Google OAuth (Record only: the Next.js app does not read these)
# Google sign-in is handled by Supabase. Enter Client ID and Secret in:
# Supabase Dashboard → Authentication → Providers → Google.
# Do NOT add GOOGLE_OAUTH_CLIENT_SECRET to Vercel.
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# In Google Cloud Console → Credentials → this OAuth client → Authorized redirect URIs,
# add exactly this URL (replace your-project-id with your Supabase project ID):
GOOGLE_OAUTH_CALLBACK_URL=https://your-project-id.supabase.co/auth/v1/callback